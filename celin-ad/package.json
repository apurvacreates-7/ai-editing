{
  "name": "celin-ad",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Celin Vitamin C 15s vertical motion-graphics ad (Remotion)",
  "scripts": {
    "studio": "remotion studio",
    "audio": "node scripts/generate-audio.mjs",
    "srt": "node scripts/generate-srt.mjs",
    "preview": "remotion render CelinAd out/celin-ad-preview.mp4 --frames=0-89",
    "stills": "node scripts/render-stills.mjs",
    "render": "remotion render CelinAd out/celin-ad.mp4",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource/manrope": "5.1.1",
    "@remotion/bundler": "4.0.530",
    "@remotion/cli": "4.0.530",
    "@remotion/noise": "4.0.530",
    "@remotion/renderer": "4.0.530",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "remotion": "4.0.530"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "node-web-audio-api": "2.2.0",
    "typescript": "5.6.3"
  },
  "engines": {
    "node": ">=22.18"
  }
}
